# Copy to .env (Prisma CLI) and .env.local (Next.js). Never commit real values.
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"
# Used by the Playwright/unit test DB (separate database on the same local server)
TEST_DATABASE_URL="postgresql://app:app@localhost:5432/app_test?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Linear (scripts/linear.ts). Personal API key: Linear > Settings > Security & access.
LINEAR_API_KEY=""
LINEAR_TEAM_KEY="AEG"
# Kit "Ready" maps to this existing state (Aegis has no Ready state)
LINEAR_STATE_READY="Todo"
# Comma-separated hosts db-guard accepts besides localhost/127.0.0.1/::1 (e.g. a CI service host)
DB_GUARD_ALLOWED_HOSTS="postgres"

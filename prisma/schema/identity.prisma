// Identity (ADR 0009): guests and accounts share one User row. No contact address is ever stored.
// Later schema files relate to User.id with onDelete: Cascade.

enum AvatarStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String           @id @default(cuid())
  isGuest            Boolean          @default(true)
  /// Unique public display name (guests get `<Animal>-<3 digits>`).
  typistName         String           @unique
  /// As typed by the user; uniqueness is enforced on usernameNormalized.
  username           String?
  /// normalizeUsername(username) from src/features/identity: case-insensitive uniqueness.
  usernameNormalized String?          @unique
  passwordHash       String?
  /// Bumped to revoke every JWT issued before (ADR 0009).
  tokenVersion       Int              @default(0)
  avatarKey          String?
  avatarStatus       AvatarStatus     @default(NONE)
  /// The clerk outfit config of bible 10.1, validated by outfitSchema; null = never saved
  outfit             Json?
  createdAt          DateTime         @default(now())
  lastSeenAt         DateTime         @default(now())
  hostedLobbies      Lobby[]          @relation("LobbyHost")
  raceResults        RaceResult[]
  raceKeystrokes     RaceKeystrokes[]
  oauthAccounts      OAuthAccount[]
  recoveryCode       RecoveryCode?
  preference         Preference?
  passwordResets     PasswordReset[]
  issuedResets       PasswordReset[]  @relation("PasswordResetIssuer")
}

enum OAuthProvider {
  GITHUB
  DISCORD
}

/// A sign-in link to GitHub or Discord (#486). Only the provider and its account id are kept:
/// sessions are JWTs (ADR 0009), so nothing else from the provider is stored.
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// One recovery code per account (ADR 0009), stored as an Argon2id hash (#46); rotated in place.
model RecoveryCode {
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
}

/// A host-issued single-use password reset code (#788, owner decision 2026-11-03 on #445). Only the
/// Argon2id hash of the code is stored; the row is also the audit record (who issued it, for whom,
/// from which room, when, used when). The newest unused, unexpired row of a user is the redeemable one.
model PasswordReset {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash       String
  /// The host who issued it; kept null when that account is deleted, so the audit row survives.
  issuedByUserId String?
  issuedBy       User?     @relation("PasswordResetIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  /// Room code of the lobby the host issued it from (ROOM_CODE_RE).
  lobbyCode      String
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?

  @@index([userId, issuedAt])
  @@index([issuedByUserId])
}

enum KeyboardLayout {
  CSA
  FR_CA
  US_QWERTY
  AZERTY
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

/// UI locale; independent of the race text language (RaceLanguage, R190).
enum Locale {
  FR
  EN
}

/// One settings row per user; defaults match #66 C2 so a bare row reads as "not chosen yet".
model Preference {
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout    KeyboardLayout?
  theme     Theme           @default(SYSTEM)
  locale    Locale?
  sound     Boolean         @default(true)
  updatedAt DateTime        @updatedAt
}

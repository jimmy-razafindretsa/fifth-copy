# Copy to .env (Prisma CLI) and .env.local (Next.js). Never commit real values.
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"
# Used by the Playwright/unit test DB (separate database on the same local server)
TEST_DATABASE_URL="postgresql://app:app@localhost:5432/app_test?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Auth.js session JWTs and the guest identity cookie fc_guest (ADR 0009), >= 32 chars (generate: openssl rand -hex 32)
AUTH_SECRET=
# OAuth apps (ADR 0009, #49), optional: a provider shows only when both its id and secret are set.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Google (#828): an OAuth client of type "Web application"; redirect URI <app url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Avatar files root (ADR 0014). Optional: defaults to .data/avatars locally; production mounts a volume at /data/avatars
# AVATAR_DIR=".data/avatars"
# Avatar moderator (ADR 0015): "heuristic" (default) or "fake" (tests/e2e: green approve, blue flag, red reject). "fake" is refused when NODE_ENV=production
# AVATAR_MODERATOR="heuristic"
# Board (scripts/board.ts): GitHub issues + Project, accessed through `gh` (run `gh auth login`; scopes repo, project).
# No token here. All optional; defaults shown.
BOARD_REPO="jimmy-razafindretsa/fifth-copy"
BOARD_PROJECT_OWNER="jimmy-razafindretsa"
BOARD_PROJECT_NUMBER="2"
BOARD_WIP_LIMIT="1"
# DB_GUARD_ALLOWED_HOSTS: comma-separated hosts db-guard accepts besides localhost/127.0.0.1/::1 (e.g. a CI service host); spaces around entries are ignored
DB_GUARD_ALLOWED_HOSTS="postgres"
# Real-time race server (services/race-server, docs/adr/0006). Redis is ephemeral state only (docs/adr/0008).
RACE_SERVER_PORT="4000"
# Also the web's (ADR 0020): rate limiter (fails open) and internal nonce store (#716, fails closed); required in production.
REDIS_URL="redis://localhost:6379"
# WEB_RATE_LIMIT="off" turns only the web rate limiter off (Playwright sets it with PLAYWRIGHT_E2E="1"; refused in production otherwise; default on)
# Browser -> race server socket origin; web -> race server internal API; shared HMAC secret (generate: openssl rand -hex 32)
NEXT_PUBLIC_RACE_SERVER_URL="http://localhost:4000"
RACE_SERVER_INTERNAL_URL="http://localhost:4000"
RACE_TOKEN_SECRET="change-me-to-64-hex-chars-from-openssl-rand-hex-32"
# Race server: allowed Socket.IO CORS origin (the web app's public URL)
WEB_ORIGIN="http://localhost:3000"
# Race server: "1" divides every lifecycle duration by 10 (e2e fast clock, docs/adr/0012); off in dev and prod
RACE_FAST_CLOCK="0"
# e2e only (#868): the line-cut grace in ms; playwright.config.ts sets 20000 for its race server. Unset elsewhere.
# RACE_GRACE_MS=""
# Race server: longest drain after SIGTERM in seconds (#704); Railway's draining time must be longer
RACE_DRAIN_CAP_S="900"
# Railway sets this itself on web and race-server (ADR 0019, #718): /api/health and /health report it as `commit`
# for the deploy-check workflow. Leave empty locally and in CI (health then reports commit: null).
RAILWAY_GIT_COMMIT_SHA=
